{{ header }}
import { Injectable{% if use_http %}, inject{% endif %} } from "@angular/core";
{% if use_http %}
import { HttpClient{% if use_params %}, HttpParams{% endif %} } from "@angular/common/http";
{% endif %}
{% if model_imports %}
import type {
{% for name in model_imports %}
  {{ name }},
{% endfor %}
} from "../models/{{ slug }}.models";
{% endif %}
{% if use_observable %}
import type { Observable } from "rxjs";
{% endif %}

@Injectable()
export class {{ class_name }} {
{% if use_http %}
  private readonly http = inject(HttpClient);
{% endif %}
{% for method in methods %}

  {{ method.signature }} {
{% for line in method.lines %}
    {{ line }}
{% endfor %}
  }
{% endfor %}
}
